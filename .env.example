# Environment Configuration for AI-Based Smart SOC Manager

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
API_HOST=0.0.0.0
API_PORT=8000
API_TOKEN=soc-secret-token-change-in-production

# Automation Kill Switch & Mode: off | recommend_only | auto
AUTOMATION_MODE=recommend_only

# Database (PostgreSQL in Docker, SQLite fallback for local test/dev)
DATABASE_URL=postgresql+psycopg://soc_user:soc_password@localhost:5432/soc_db
# For local dev without Postgres: sqlite:///soc.db
# DATABASE_URL=sqlite:///./soc.db

# Config Paths (relative to repo root or absolute)
CONFIG_DIR=soc/config
MODEL_DIR=ids_project

# Guardrail & Safety Defaults
SOC_EXECUTOR=dry_run             # dry_run | simulated | lab
SOC_LAB_MODE=false               # Must be true for lab execution
LAB_ALLOWED_CIDRS=10.10.0.0/16,10.66.0.0/24
MAX_AUTO_ACTIONS_PER_MIN=10
MAX_ACTIVE_BLOCKS=50
DEFAULT_BLOCK_TTL_S=900

# Explainability Thresholds
SHAP_RISK_THRESHOLD=60.0
SHAP_BACKGROUND_SAMPLE_SIZE=100
