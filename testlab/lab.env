# testlab namespace addressing (single-machine two-"namespace" lab)
# Sourced by testlab/*.sh. Faithful to the MASTER PRD's 10.66.0.0/24 lab subnet.
#
# NOTE ON SCOPE: this project's detection path is NFStream + the heuristic
# classifier + the decision pipeline (soc/backend). There is NO Suricata,
# flow_bridge.py, guard.sh or lab/ attacker suite in this repo, so the PRD's
# TESTLAB_MODE/guard.sh branch and eve.json ingestion do not apply. The attacker
# namespace instead runs scripts/gen_traffic.py (pure Python, no extra installs)
# or any installed tool (nmap/hping3/hydra) via testlab/run_attacker.sh.

LAB_SUBNET=10.66.0.0/24
DEFENDER_LAB_IP=10.66.0.10      # host end of the veth pair (what NFStream watches)
ATTACKER_LAB_IP=10.66.0.20      # inside the attacker namespace (non-allowlisted source)
LAB_IFACE=veth-def              # host-side interface the SOC monitor captures on
ATTACKER_NETNS=attacker
VETH_DEF=veth-def
VETH_ATT=veth-att
